# Copy this file to src/.env and fill in real values.
# src/.env is listed in .gitignore and must NEVER be committed or zipped.
# On EC2 these values are written by src/infra/user-data.sh instead.

# Local XAMPP example: DB_HOST=localhost, DB_USER=root, DB_PASSWORD= (empty)
# AWS example:        DB_HOST=<rds-endpoint>.rds.amazonaws.com, DB_USER=lostfound_app

DB_HOST=your-database-host
DB_USER=lostfound_app
DB_PASSWORD=change-me
DB_NAME=inf2006
